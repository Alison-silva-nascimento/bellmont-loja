# Copy to supabase/functions/.env for local use; that destination is ignored.
# Never prefix private server values with VITE_.
CHECKOUT_V2_ENABLED=false
CHECKOUT_ALLOWED_ORIGINS=http://127.0.0.1:5173,https://bellmontloja.com.br
CHECKOUT_APP_URL=http://127.0.0.1:5173

# Must come from a reviewed shipping rule/provider. No default is assumed.
CHECKOUT_SHIPPING_CENTS=
CHECKOUT_RATE_LIMIT_SECRET=

# Mercado Pago TEST credentials only until explicit production approval.
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_ACCESS_TOKEN_TEST=
MERCADO_PAGO_WEBHOOK_SECRET_TEST=

# Local mock override is accepted only in sandbox and only for localhost hosts.
MERCADO_PAGO_ALLOW_LOCAL_MOCK=false
MERCADO_PAGO_API_BASE=
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
