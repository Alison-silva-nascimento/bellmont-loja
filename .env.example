# Frontend-safe values only. Copy to .env.local and replace locally.
# Never place service_role, secret keys, database passwords or connection
# strings in a VITE_* variable: Vite exposes VITE_* values to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Optional. Defaults to local so production keeps using src/data/products.ts.
# Set to supabase only for controlled validation of the public catalog.
VITE_PUBLIC_CATALOG_SOURCE=local
